# Copy to .env and fill in from Firebase console → Project settings → General → Your apps → Web app config.
# These are public identifiers, not secrets. Security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Your Firebase Auth UID, the only account allowed into /admin.
# Sign in at /admin once and it will show you this value. Must match firestore.rules.
VITE_FIREBASE_ADMIN_UID=
